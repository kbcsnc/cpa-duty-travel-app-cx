        <script><![CDATA[(function() {

    if (input) {
        data.sysId = input.sysId;

        if (input.action == 'closeCase') {
            current.state = 'cancelled'; // Or your cancellation state
current.work_notes = 'Request cancelled by user.';
current.update();
        }

    } else {
        data.table = $sp.getParameter('table');
        data.sysId = $sp.getParameter('sys_id');
    }

    

})();]]></script>
