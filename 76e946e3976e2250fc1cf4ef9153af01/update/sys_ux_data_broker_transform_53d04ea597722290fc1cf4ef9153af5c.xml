        <name>Get HKO Weather</name>
        <output_schema>{&#13;
 "html": "An anticyclone aloft is covering the coast of Guangdong and the northern part of the South China Sea.",&#13;
 "updatedOn": "2025-07-07 01:08:34"&#13;
}</output_schema>
        <private>false</private>
        <props>[{&#13;
  "name": "language",&#13;
  "label": "Language",&#13;
  "fieldType": "string",&#13;
  "mandatory": true&#13;
}]</props>
        <required_translations>[ {
  "message" : "Language",
  "comment" : ""
} ]</required_translations>
        <schema_version>1.0.0</schema_version>
        <script><![CDATA[function transform(input) {
	var language = input.language;

	var result = {};

	try {
		var eps = new GlideScriptedExtensionPoint().getExtensions("HKOWeatherHandler");
		eps.some(function (ePoint) {
			result = ePoint.getHKOWeather(language);
		});
	} catch (ex) {
		gs.error("Error running HKOWeatherHandler extension points");
	}

	return result;
}]]></script>
