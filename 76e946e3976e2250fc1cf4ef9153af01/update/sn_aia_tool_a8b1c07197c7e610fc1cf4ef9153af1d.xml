<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sn_aia_tool">
    <sn_aia_tool action="INSERT_OR_UPDATE">
        <active>true</active>
        <description>This subflow retrieves travel alerts issued by the HK Security Bureau for a specified destination country. It takes a single input, "Country", which is used to look up the corresponding travel alert record. The subflow then checks if a travel alert record is found. If a record is found, it assigns the travel alert classification, details, and recommendations as outputs. If no record is found, it assigns "No Travel Alerts" as the travel alert classification output.</description>
