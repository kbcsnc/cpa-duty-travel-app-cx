        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var leaveIcon = ']]>🛫<![CDATA[';
	var goingIcon = ']]>🛬<![CDATA[';
	var returnIcon = '↩️';
	var onewayIcon = '➡️';

	var tripType = '';

	if (current.trip_type.getDisplayValue() === 'Return') {
		tripType = returnIcon;
	} else if (current.trip_type.getDisplayValue() === 'One way') {
		tripType = onewayIcon;
	}

	current.short_description = current.traveller.name+' | '+leaveIcon+' '+current.leaving_from.iata+' '+goingIcon+' '+current.going_to.iata+' '+tripType+' | '+current.airline.iata+' | Cabin: '+current.cabin_class.toUpperCase();

})(current, previous);]]></script>
