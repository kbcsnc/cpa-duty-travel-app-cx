        <schema_version>1.0.0</schema_version>
        <script><![CDATA[function transform(input) {
	var sysId = input.sysId;
	var table = input.table;

	var result = {};

	try {
		var eps = new GlideScriptedExtensionPoint().getExtensions("NowAssistSummaryHandler");
		eps.some(function (ePoint) {
			if (ePoint.handles(table)) {
				result = ePoint.getSummaryFor(table, sysId);
			}
		});
	} catch (ex) {
		gs.error("Error running NowAssistSummaryHandler extension points");
	}

	return result;
}]]></script>
